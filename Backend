// ==========================================
// 5. PARSER & HANDLER HIOSO OLT TELNET
// ==========================================
function parseHiosoUnauthOutput(rawOutput) {
  const lines = rawOutput.split('\n');
  const onus = [];
  
  for (let line of lines) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.includes('MAC') || trimmed.includes('----') || trimmed.includes('OLT>') || trimmed.includes('en')) {
      continue;
    }
    
    const parts = trimmed.split(/\s+/);
    if (parts.length >= 2) {
      onus.push({
        ponPort: parts[0],          
        macAddress: parts[1],       
        onuSn: parts[2] || 'N/A'    
      });
    }
  }
  return onus;
}

async function getUnregisteredOnu() {
  const connection = new Telnet(); // <-- Menggunakan Telnet
  try {
    await connection.connect(hiosoOltConfig);
    console.log('[HiOSO HA7302CS] Terhubung via Telnet untuk mengambil unauth ONU.');

    const commands = [
      'en',
      hiosoOltConfig.password,
      'show epon onu unauthen'
    ];

    let rawOutput = '';
    for (const cmd of commands) {
      rawOutput = await connection.exec(cmd);
    }

    await connection.end();
    return parseHiosoUnauthOutput(rawOutput);
  } catch (err) {
    console.error('[HiOSO OLT Error] Gagal mengambil data unauth:', err.message);
    try { await connection.end(); } catch (e) {}
    return []; 
  }
}

async function registerOnuToHiosoOlt(oltData) {
  const connection = new Telnet(); // <-- Menggunakan Telnet
  try {
    await connection.connect(hiosoOltConfig);
    console.log(`[HiOSO HA7302CS] Mendaftarkan ONU ke Port PON ${oltData.ponPort}...`);

    const commands = [
      'en',
      hiosoOltConfig.password,
      'conf t',
      `interface epon ${oltData.ponPort}`,
      `onu bind-table add mac ${oltData.macAddress} sn ${oltData.onuSn}`,
      `onu description ${oltData.username}`,
      'end',
      'write' 
    ];

    for (const cmd of commands) {
      await connection.exec(cmd);
    }

    await connection.end();
    return true;
  } catch (err) {
    console.error('[HiOSO OLT Error] Gagal registrasi ONU:', err.message);
    try { await connection.end(); } catch (e) {}
    throw new Error('Gagal registrasi ke HiOSO OLT: ' + err.message);
  }
}

