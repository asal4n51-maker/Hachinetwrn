// 7. ENGINE SINKRONISASI MULTI-OLT
// ==========================================
async function syncMultiOLTStatus() {
    console.log("\n==========================================");
    console.log(" MENJALANKAN MONITORING MULTI-VENDOR OLT ");
    console.log("==========================================");

    for (const olt of oltDevices) {
        try {
            console.log(`\n[Multi-OLT Engine] Memproses ${olt.name}...`);
            let oltResultData = null;

            switch (olt.vendor.toLowerCase()) {
                case 'hioso': oltResultData = await fetchHiosoData(olt); break;
                case 'vsol': oltResultData = await fetchVsolData(olt); break;
                case 'huawei': oltResultData = await fetchHuaweiData(olt); break;
                case 'zte': oltResultData = await fetchZteData(olt); break;
                case 'hsgq':
                case 'cdata': oltResultData = await fetchHsgqData(olt); break;
                case 'fiberhome': oltResultData = await fetchFiberHomeData(olt); break;
                default:
                    oltResultData = { oltId: olt.id, name: olt.name, status: 'UNKNOWN' };
            }

            await saveToFirestore('multi_olt_data', olt.id, oltResultData);
        } catch (err) {
            console.error(`[OLT Error] Gagal membaca ${olt.name}:`, err.message);
        }
    }
}

