app.post('/api/sinkronisasi-pelanggan', async (req, res) => {
  const { 
    username, 
    password, 
    profile, 
    targetIp, 
    maxLimit, 
    onuSn, 
    macAddress, 
    ponPort 
  } = req.body;
  
  const client = new RouterOSClient(mikrotikConfig);
  
  try {
    await client.connect();

    const pppMenu = client.menu('/ppp/secret');
    await pppMenu.add({
        name: username,
        password: password,
        profile: profile || 'default',
        service: 'pppoe'
    });

    const queueMenu = client.menu('/queue/simple');
    await queueMenu.add({
        name: `client_${username}`,
        target: targetIp,
        'max-limit': maxLimit || '10M/10M'
    });

    await client.close();

    if (onuSn && macAddress && ponPort) {
      await registerOnuToHiosoOlt({
        username,
        onuSn,
        macAddress,
        ponPort
      });
    }

    res.json({ 
      success: true, 
      message: 'Berhasil sinkronisasi pelanggan ke MikroTik & HiOSO HA7302CS OLT!' 
    });

  } catch (err) {
    console.error('[Backend Error] Sinkronisasi gagal:', err.message);
    res.status(500).json({ success: false, error: err.message });
  }
});

